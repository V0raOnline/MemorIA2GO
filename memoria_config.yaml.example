#=============================================
# MemorIA2GO — Configuración
# Copia este archivo a memoria_config.yaml y rellena tus rutas
#=============================================

paths:
  # 📦 Carpeta base donde se crea el vault
  base_vault: 'G:\ruta\a\tu\vault'

  # 🗄️ Fuente de las notas (RAW) — OPCIONAL. Vacío = dentro de base_vault, en
  # RAW_VAULT, como siempre. Es la materia prima del pipeline, no algo pensado
  # para recorrerse: si no quieres que aparezca al abrir el vault en Obsidian,
  # ponla en otra carpeta (otro disco, o fuera del vault).
  # Si ya tienes un vault con RAW, NO cambies esto a mano: usa
  #   python mover_raw.py --hacia <carpeta>
  # que copia, verifica y no borra el original. Si lo cambias sin mover, el
  # pipeline se niega a seguir en vez de partir tu fuente en dos.
  raw_vault: ''

  # 🧾 Carpeta con los exports de ChatGPT (.zip/.json/.html)
  exports_dir: 'G:\ruta\a\tus\exports'

  # 🧩 Mapa de proyectos: id → nombre legible (opcional)
  gizmo_map: 'G:\ruta\a\MemorIA2GO\gizmo_map.json'

  # 🎵 MUSIC·0LOGY — carpeta del backup de Suno (la que contiene _index.json).
  # Opcional: sin esto, la tarjeta de música simplemente no aparece.
  suno_backup: ''

  # 🎵 MUSIC·0LOGY — vault de Obsidian donde se construyen las canciones.
  # Separado del vault de conversaciones: es otro pipeline.
  suno_vault: ''

  # 🎵 MUSIC·0LOGY — carpeta del backup de Flow Music (la que contiene
  # _index.json). La segunda fuente de música, con la API de Riffusion.
  # Opcional, igual que la de Suno: sin esto, su sección no aparece.
  #
  # Puede apuntar FUERA del repo, y de hecho conviene: el backup con los
  # wav pasa de los 6 GB. Los scripts no asumen que esté al lado del
  # código.
  flowmusic_backup: ''

  # 🎵 MUSIC·0LOGY — vault de Obsidian de Flow Music. Separado del de Suno:
  # son dos bibliotecas distintas y mezclarlas haría ilegible el linaje.
  flowmusic_vault: ''

  # 🖼️ image.ia — backup de las imágenes de Copilot (las imágenes y un .json
  # por cada una con su prompt) y vault de Obsidian donde se construyen las
  # notas. Opcionales e independientes, como las de música.
  # Grok Imagine no necesita ruta propia: usa base_vault y deja lo descargado
  # en GROK/IMAGINE, junto al resto de bancos de Grok.
  copilot_images_backup: ''
  copilot_images_vault: ''

  # 🖋️ Tintero — vault de Obsidian donde se construyen tus posts de Substack.
  # Separado también: un post no es una conversación.
  # El export y el CSV de estadísticas NO necesitan ruta propia: viven en
  # exports_dir, la de siempre. El pipeline de conversaciones los rechaza y
  # Tintero los recoge — una carpeta, dos puertas.
  substack_vault: ''

#=============================================
# ⚙️  Opciones de procesamiento
#=============================================

options:

  #--- Como se organiza el vault fusionado (MERGED_VAULT) ---
  #   proyectos  = todas las conversaciones mezcladas en MERGED_VAULT/Conversaciones y,
  #                ademas, PRJ_VAULT con una carpeta por proyecto. Es lo de siempre.
  #   unico      = lo mismo pero SIN vault de proyectos.
  #   proveedor  = una carpeta por proveedor dentro de MERGED_VAULT (ChatGPT, Claude,
  #                Grok...), cada una con su Conversaciones. Sin vault de proyectos.
  # Vacio = proyectos. En un vault que YA tiene conversaciones fusionadas no se puede
  # cambiar la organizacion sin migrarlo: el pipeline se niega en vez de duplicarlas.
  layout_preset: ''

  #--- Nombre del vault de proyectos ---
  prj_vault_name: 'PRJ_VAULT'

  #--- Importación ---
  make_index: true
  by_year: true
  by_month: true

  #--- Deduplicación ---
  keep_hashes: false   # true = conserva variantes de hash, solo borra numerados

  #--- Generales ---
  dry_run: false       # true = solo muestra qué haría, no modifica nada

  #--- Apariencia ---
  # Tema de color de la interfaz. Valores: 'warm' (por defecto, cálido),
  # 'cool' (frío) o 'light' (claro). Se cambia desde Configuración → Apariencia
  # y se aplica al instante.
  theme: 'warm'
